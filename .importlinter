[importlinter]
root_package = taipanstack
include_external_packages = False

# Core independence - core module should not import security, utils, or resilience
# Core provides foundation types that other modules depend on
[importlinter:contract:core-isolation]
name = Core Layer Isolation
type = forbidden
source_modules =
    taipanstack.core
forbidden_modules =
    taipanstack.security
    taipanstack.utils
    taipanstack.config
    taipanstack.resilience

# Resilience layer - may import core but not security, config, or integrations
# Resilience provides patterns (retry, circuit breaker) built on core types
[importlinter:contract:resilience-isolation]
name = Resilience Layer Isolation
type = forbidden
source_modules =
    taipanstack.resilience
forbidden_modules =
    taipanstack.security
    taipanstack.config

# Config generators should not import utils directly
# Configuration generation should be self-contained
[importlinter:contract:config-independence]
name = Config Module Independence
type = forbidden
source_modules =
    taipanstack.config
forbidden_modules =
    taipanstack.utils.subprocess
    taipanstack.utils.filesystem

# Bridges layer - may import core, security, resilience but not config or utils internals
[importlinter:contract:bridges-isolation]
name = Bridges Layer Isolation
type = forbidden
source_modules =
    taipanstack.bridges
forbidden_modules =
    taipanstack.config
