# Python Stack Bootstrapper - Environment Variables Template
# Copy this file to .env and customize values as needed

# Project Configuration
# PROJECT_NAME=my_project
# PROJECT_VERSION=0.1.0

# Python Configuration
# PYTHON_VERSION=3.11

# Security Configuration
# SECURITY_LEVEL=strict
# ENABLE_BANDIT=true
# ENABLE_SEMGREP=true
# ENABLE_DETECT_SECRETS=true

# Dependencies Configuration
# INSTALL_RUNTIME_DEPS=true
# INSTALL_DEV_DEPS=true

# Development Settings
# DEBUG=true
# LOG_LEVEL=INFO
# LOG_FORMAT=detailed
# ENABLE_STRUCTURED_LOGGING=false

# Add your project-specific environment variables below
